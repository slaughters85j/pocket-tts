#!/bin/bash
# Wrapper to run pocket-tts-stream.py via uv
# Installed to /usr/local/bin by install-quick-action.sh

SCRIPT_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"

# If running from /usr/local/bin, use the installed Python script location
if [[ "$0" == "/usr/local/bin/pocket-tts-stream" ]]; then
    PYTHON_SCRIPT="/usr/local/share/pocket-tts/pocket-tts-stream.py"
else
    PYTHON_SCRIPT="$SCRIPT_DIR/pocket-tts-stream.py"
fi

# uv location (Homebrew or default)
UV_PATH="${UV_PATH:-/Users/system-backup/.local/bin/uv}"
if [[ ! -x "$UV_PATH" ]]; then
    UV_PATH="/opt/homebrew/bin/uv"
fi
if [[ ! -x "$UV_PATH" ]]; then
    UV_PATH="$(which uv 2>/dev/null)"
fi

if [[ ! -x "$UV_PATH" ]]; then
    osascript -e 'display notification "uv not found. Install with: curl -LsSf https://astral.sh/uv/install.sh | sh" with title "Pocket TTS Error"'
    exit 1
fi

exec "$UV_PATH" run "$PYTHON_SCRIPT" "$@"
